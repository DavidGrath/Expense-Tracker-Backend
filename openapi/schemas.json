{
    "openapi": "3.0.0",
    "components": {
        "schemas": {
            "Transaction": {
                "type": "object",
                "properties": {
                    "accountId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "amount": {
                        "type": "number"
                    }
                }
            },
            "TransactionDetails": {
                "type": "object",
                "properties": {
                    "account": {
                        "$ref": "#/components/schemas/Account"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionItem"
                        }
                    },
                    "documents": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Document"
                        }
                    },
                    "date": {
                        "type": "string",
                        "format": "date"
                    },
                    "time": {
                        "type": "string",
                        "format": "time",
                        "nullable": true
                    },
                    "debitOrCredit": {
                        "type": "boolean"
                    },
                    "note": {
                        "type": "string"
                    },
                    "mode": {
                        "$ref": "#/components/schemas/TransactionMode"
                    }
                }
            },
            "TransactionItem": {
                "description": "The basic units that make up a single transaction",
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "description": {
                        "type": "string"
                    },
                    "categoryId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "isReduction": {
                        "type": "boolean"
                    },
                    "images": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionDraftFile"
                        }
                    }
                }
            },
            "Image": {
                "description": "Attached to one or more items across one or more transactions",
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "sizeBytes": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "uri": {
                        "type": "string",
                        "format": "uri"
                    },
                    "mimeType": {
                        "type": "string"
                    }
                }
            },
            "Category": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "isCustom": {
                        "type": "boolean"
                    },
                    "stringId": {
                        "type": "string"
                    }
                }
            },
            "Profile": {
                "description": "A named group of accounts"
            },
            "Account": {
                "description": "A named set of transactions in a specific currency",
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "currencyCode": {
                        "type": "string",
                        "description": "An ISO 4217 Currency Code"
                    },
                    "name": {
                        "type": "string"
                    },
                    "transactionCount": {
                        "type": "integer"
                    },
                    "totalIncome": {
                        "type": "number"
                    },
                    "totalExpenses": {
                        "type": "number"
                    }
                }
            },
            "StatisticsFilter": {
                "description": "For lists, emptiness is the same as selecting everything",
                "type": "object",
                "properties": {
                    "from": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "to": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "accounts": {
                        "description": "Accounts with multiple distinct currency codes will cause a bad request",
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "format": "int64"
                        }
                    },
                    "categories": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "format": "int64"
                        }
                    },
                    "transactionModes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionMode"
                        }
                    },
                    "includeDates": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                }
            },
            "StatsItemAndTransactionCount": {
                "type": "object",
                "properties": {
                    "transactionCounnt": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "itemCount": {
                        "type": "integer",
                        "format": "int64"
                    }
                }
            },
            "StatsTotalAmountByDate": {
                "description": "Dates where no data is present are omitted. Order is by date ascending",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/TotalAmountByDate"
                }
            },
            "TotalAmountByDate": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string",
                        "format": "date"
                    },
                    "amount": {
                        "type": "number"
                    }
                }
            },
            "StatsTotalAmountByCategory": {
                "description": "Categories where no data is present are omitted. Order is by amount descending",
                "type": "array",
                "items": {
                    "$ref": "#/components/schemas/TotalAmountByCategory"
                }
            },
            "TotalAmountByCategory": {
                "type": "object",
                "properties": {
                    "category": {
                        "$ref": "#/components/schemas/Category"
                    },
                    "amount": {
                        "type": "number"
                    }
                }
            },
            "Document": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "sizeBytes": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "uri": {
                        "type": "string",
                        "format": "uri"
                    },
                    "mimeType": {
                        "type": "string"
                    },
                    "type": {
                        "$ref": "#/components/schemas/DocumentType"
                    }
                }
            },
            "SummaryCategory": {
                "type": "object"
            },
            "AppVersion": {
                "type": "object",
                "properties": {
                    "android": {
                        "$ref": "#/components/schemas/AppPlatformVersion"
                    },
                    "ios": {
                        "$ref": "#/components/schemas/AppPlatformVersion"
                    }
                }
            },
            "AppPlatformVersion": {
                "type": "object",
                "properties": {
                    "latestVersion": {
                        "type": "string"
                    },
                    "minimumVersion": {
                        "type": "string"
                    }
                }
            },
            "TransactionDraft": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionDraftItem"
                        }
                    },
                    "deletedDbItems": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionDraftItem"
                        }
                    },
                    "documents": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionDraftFile"
                        }
                    },
                    "deletedDbDocuments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionDraftFile"
                        }
                    },
                    "date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "time": {
                        "type": "string",
                        "format": "time",
                        "nullable": true
                    },
                    "originalDate": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "originalTime": {
                        "type": "string",
                        "format": "time",
                        "nullable": true
                    },
                    "accountId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "debitOrCredit": {
                        "type": "boolean"
                    },
                    "note": {
                        "type": "string"
                    },
                    "mode": {
                        "$ref": "#/components/schemas/TransactionMode"
                    }
                }
            },
            "TransactionDraftItem": {
                "type": "object",
                "properties": {
                    "dbId": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "amount": {
                        "type": "number"
                    },
                    "description": {
                        "type": "string"
                    },
                    "categoryId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "isReduction": {
                        "type": "boolean"
                    },
                    "images": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionDraftFile"
                        }
                    },
                    "deletedDbImages": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TransactionDraftFile"
                        }
                    }
                }
            },
            "TransactionDraftFile": {
                "type": "object",
                "properties": {
                    "dbId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "sizeBytes": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "uri": {
                        "type": "string",
                        "format": "uri"
                    },
                    "mimeType": {
                        "type": "string"
                    },
                    "documentType": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/DocumentType"
                            },
                            {
                                "nullable": true
                            }
                        ]
                    }
                }
            },
            "TransactionMode": {
                "type": "string",
                "enum": [
                    "card",
                    "transfer",
                    "cash",
                    "other"
                ]
            },
            "DocumentType": {
                "type": "string",
                "enum": [
                    "bank_statement",
                    "receipt",
                    "invoice",
                    "other"
                ]
            },
            "SignUpRequest": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                }
            }
        }
    }
}