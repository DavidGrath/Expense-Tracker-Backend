      "StatisticsFilter": {
        "description": "For lists, emptiness is the same as selecting everything. The main difference from TransactionSearchFilter is that statistics enforces exactly 1 currency code, while search doesn't",
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "to": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "currencyCode": {
            "description": "If present, will be used instead of the accounts list, which will be ignored. A currency code the user does not have will return empty results",
            "type": "string",
            "pattern": "[A-Z]{3}",
            "nullable": true
          },
          "accounts": {
            "description": "There must be at least 1 account. Accounts with multiple distinct currency codes will cause a bad request.",
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "transactionModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionMode"
            }
          },
          "sellers": {
            "description": "Any seller present here will cause the corresponding locations in sellerLocations to be ignored and include all locations",
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "sellerLocations": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "weekdays": {
            "description": "ISO 8601 weekdays: Monday-Sunday, 1-7",
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "subtractReductions": {
            "description": "If any of the filters that affect line items are present e.g. categories, then this parameter will be ignored. TODO Contemplate behaviour in greater detail",
            "type": "boolean"
          }
        }
      },
