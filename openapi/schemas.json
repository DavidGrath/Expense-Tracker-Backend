      "Account": {
        "description": "A named set of transactions in a specific currency",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "profileId": {
            "type": "integer",
            "format": "int64"
          },
          "currencyCode": {
            "type": "string",
            "description": "An ISO 4217 Currency Code"
          },
          "name": {
            "type": "string"
          },
          "isDefault": {
            "description": "There can be a maximum of 1 default account per profile. A default account is used for the statistics endpoints if no account was provided. It should also be used for the add transaction screens",
            "type": "boolean"
          }
        }
      },
      "AccountDetails": {
        "description": "A named set of transactions in a specific currency",
        "type": "object",
        "properties": {
          "id": {
