            "type": "string",
            "nullable": false,
            "maxLength": 100
          },
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "nullable": false
          },
          "timeZone": {
            "type": "string",
            "description": "An IANA timezone"
          }
        },
        "required": [
          "accountId",
          "debitOrCredit",
          "amount",
          "description",
          "categoryId",
          "timeZone"
        ]
      },
