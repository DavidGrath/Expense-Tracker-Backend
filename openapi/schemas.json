      "TransactionSearchFilter": {
        "description": "For lists, emptiness is the same as selecting everything. The main difference from StatisticsFilter is that statistics enforces exactly 1 currency code, while search doesn't",
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "to": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "currencyCodes": {
            "description": "Any currency code present here will cause the corresponding accounts in the accounts list to be ignored and include all accounts for that currency code. Currency codes the user does not have will be ignored",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "accounts": {
            "description": "Unlike statistics, there is no restriction on distinct currency codes",
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "transactionModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionMode"
            }
          },
          "sellers": {
            "description": "Any seller present here will cause the corresponding locations in sellerLocations to be ignored and include all locations",
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "sellerLocations": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "weekdays": {
            "description": "ISO 8601 weekdays: Monday-Sunday, 1-7",
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          }
        }
      },
