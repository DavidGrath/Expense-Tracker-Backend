{
  "openapi": "3.0.0",
  "components": {
    "schemas": {
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "type": "number"
          },
          "debitOrCredit": {
            "type": "boolean"
          },
          "currencyCode": {
            "type": "string",
            "description": "An ISO 4217 Currency Code"
          },
          "note": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/TransactionMode"
          }
        }
      },
      "TransactionDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "type": "number"
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionItem"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "format": "time",
            "nullable": true
          },
          "debitOrCredit": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/TransactionMode"
          }
        }
      },
      "TransactionItem": {
        "description": "The basic units that make up a single transaction",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "isReduction": {
            "type": "boolean"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          }
        }
      },
      "Image": {
        "description": "Attached to one or more items across one or more transactions",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "mimeType": {
            "type": "string"
          }
        }
      },
      "ImageDetails": {
        "description": "Attached to one or more items across one or more transactions",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "mimeType": {
            "type": "string"
          },
          "transactionCount": {
            "type": "integer",
            "format": "int64"
          },
          "itemCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "isCustom": {
            "type": "boolean"
          },
          "stringId": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        }
      },
      "CategoryDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "isCustom": {
            "type": "boolean"
          },
          "stringId": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "transactionCount": {
            "type": "integer",
            "format": "int64"
          },
          "itemCount": {
            "type": "integer",
            "format": "int64"
          }

        }
      },
      "CategoryCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": false,
            "maxLength": 50
          },
          "icon": {
            "type": "string",
            "nullable": false
          }
        },
        "required": ["name", "icon"]
      },
      "CategoryUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": false,
            "maxLength": 50
          },
          "icon": {
            "type": "string",
            "nullable": false
          }
        },
        "required": ["name", "icon"]
      },
      "Profile": {
        "description": "A named group of accounts",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "stringId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Account": {
        "description": "A named set of transactions in a specific currency",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "profileId": {
            "type": "integer",
            "format": "int64"
          },
          "currencyCode": {
            "type": "string",
            "description": "An ISO 4217 Currency Code"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "AccountDetails": {
        "description": "A named set of transactions in a specific currency",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "profileId": {
            "type": "integer",
            "format": "int64"
          },
          "currencyCode": {
            "type": "string",
            "description": "An ISO 4217 Currency Code"
          },
          "name": {
            "type": "string"
          },
          "transactionCount": {
            "type": "integer",
            "format": "int64"
          },
          "itemCount": {
            "type": "integer",
            "format": "int64"
          },
          "totalIncome": {
            "type": "number"
          },
          "totalExpenses": {
            "type": "number"
          }
        }
      },
      "StatisticsFilter": {
        "description": "For lists, emptiness is the same as selecting everything",
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "to": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "accounts": {
            "description": "Accounts with multiple distinct currency codes will cause a bad request",
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "transactionModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionMode"
            }
          },
          "sellers": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "includeDates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "StatsTransactionAndItemCount": {
        "type": "object",
        "properties": {
          "transactionCount": {
            "type": "integer",
            "format": "int64"
          },
          "itemCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "StatsTotalAmountByDate": {
        "description": "Dates where no data is present are omitted. Order is by date ascending",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TotalAmountByDate"
        }
      },
      "TotalAmountByDate": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "StatsTotalAmountByCategory": {
        "description": "Categories where no data is present are omitted. Order is by amount descending",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TotalAmountByCategory"
        }
      },
      "TotalAmountByCategory": {
        "type": "object",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "transactionId": {
            "type": "integer",
            "format": "int64"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "mimeType": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/DocumentType"
          }
        }
      },
      "DocumentDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "transactionId": {
            "type": "integer",
            "format": "int64"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "mimeType": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "transactionDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "AppVersion": {
        "type": "object",
        "properties": {
          "android": {
            "$ref": "#/components/schemas/AppPlatformVersion"
          },
          "ios": {
            "$ref": "#/components/schemas/AppPlatformVersion"
          }
        }
      },
      "AppPlatformVersion": {
        "type": "object",
        "properties": {
          "latestVersion": {
            "type": "string"
          },
          "minimumVersion": {
            "type": "string"
          }
        }
      },
      "TransactionDraft": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionDraftItem"
            }
          },
          "deletedDbItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionDraftItem"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionDraftFile"
            }
          },
          "deletedDbDocuments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionDraftFile"
            }
          },
          "date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "time": {
            "type": "string",
            "format": "time",
            "nullable": true
          },
          "originalDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "originalTime": {
            "type": "string",
            "format": "time",
            "nullable": true
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "debitOrCredit": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/TransactionMode"
          },
          "sellerId": {
            "type": "integer",
            "format": "int64"
          },
          "sellerLocationId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "TransactionDraftItem": {
        "type": "object",
        "properties": {
          "dbId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "integer",
            "format": "int64"
          },
          "isReduction": {
            "type": "boolean",
            "default": false
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "brand": {
            "type": "string"
          },
          "variation": {
            "type": "string"
          },
          "referenceNumber": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionDraftFile"
            }
          },
          "deletedDbImages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionDraftFile"
            }
          }
        },
        "required": ["amount", "description", "categoryId"]
      },
      "TransactionDraftItemUpdateRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "maxLength": 100
          },
          "categoryId": {
            "type": "integer",
            "format": "int64"
          },
          "isReduction": {
            "type": "boolean",
            "default": false
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "brand": {
            "type": "string"
          },
          "variation": {
            "type": "string"
          },
          "referenceNumber": {
            "type": "string"
          }
        },
        "required": ["amount", "description", "categoryId"]
      },
      "TransactionDraftFile": {
        "type": "object",
        "properties": {
          "dbId": {
            "type": "integer",
            "format": "int64"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "mimeType": {
            "type": "string"
          },
          "documentType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DocumentType"
              },
              {
                "nullable": true
              }
            ]
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "TransactionDraftUpdateRequest": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "format": "time"
          },
          "accountId": {
            "type": "integer",
            "format": "int64",
            "nullable": false
          },
          "debitOrCredit": {
            "type": "boolean",
            "nullable": false
          },
          "note": {
            "type": "string",
            "maxLength": 400
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TransactionMode"
              },
              {
                "nullable": false
              }
            ]
          },
          "sellerId": {
            "type": "integer",
            "format": "int64"
          },
          "sellerLocationId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": ["accountId", "debitOrCredit", "mode"]
      },
      "TransactionMode": {
        "type": "string",
        "enum": [
          "card",
          "transfer",
          "cash",
          "other"
        ]
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "bank_statement",
          "receipt",
          "invoice",
          "other"
        ]
      },
      "SignUpRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": false
          },
          "password": {
            "type": "string",
            "nullable": false
          },
          "languageTag": {
            "type": "string",
            "description": "A BCP-47 language tag. Used to create the default account"
          }
        }
      },
      "BasicTransactionCreateRequest": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64",
            "nullable": false
          },
          "debitOrCredit": {
            "type": "boolean",
            "nullable": false
          },
          "amount": {
            "type": "number",
            "nullable": false,
            "minimum": 0.0,
            "exclusiveMinimum": true
          },
          "description": {
            "type": "string",
            "nullable": false,
            "maxLength": 100
          },
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "nullable": false
          },
          "timeZone": {
            "type": "string",
            "description": "An IANA timezone"
          }
        },
        "required": [
          "accountId",
          "debitOrCredit",
          "amount",
          "description",
          "categoryId",
          "timeZone"
        ]
      },
      "AccountCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20
          },
          "currencyCode": {
            "type": "string",
            "description": "An ISO 4217 Currency Code",
            "maxLength": 3
          }
        }
      },
      "AccountUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "TransactionsEarliestDateResponse": {
        "type": "string",
        "format": "date"
      },
      "SuggestionsFieldType": {
        "type": "string",
        "enum": ["description", "brand", "variation"]
      },
      "SuggestionsResponse": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "SuggestionsQuery": {
        "type": "string",
        "maxLength": 20
      },
      "Seller": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "SellerCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "SellerUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "SellerLocationCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "SellerLocationUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "SellerDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SellerLocation"
            }
          }
        }
      },
      "SellerLocation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DocumentUploadRequest": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "document": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "FileUploadRequest": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": ["file"]
      }
    }
  }
}