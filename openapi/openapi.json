          }
        }
      },
      "post": {
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          }
        ],
        "tags": [
          "categories"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas.json#/components/schemas/CategoryCreateRequest"
