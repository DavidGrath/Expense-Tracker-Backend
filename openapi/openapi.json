{
  "openapi": "3.0.0",
  "info": {
    "title": "ExTrack API",
    "version": "0.1.4",
    "description": "API for the client-server version of ExTrack. It's meant to mirror the offline version for the most part"
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "transactions"
    },
    {
      "name": "profiles"
    },
    {
      "name": "accounts"
    },
    {
      "name": "statistics"
    },
    {
      "name": "auth"
    },
    {
      "name": "categories"
    }
  ],
  "paths": {
    "/versionCheck": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas.json#/components/schemas/AppVersion"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "A JWT bearer token",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signUp": {
      "post": {
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas.json#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A JWT bearer token",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "post": {
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas.json/#/components/schemas/TransactionDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction created successfully"
          }
        }
      },
      "get": {
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          },
          {
            "name": "accountIds",
            "description": "If accounts with multiple distinct currencies are selected, then only the currency of the first account will be used",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64",
                "nullable": false
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "./schemas.json#/components/schemas/TransactionDetails"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/transactions/basic": {

      "parameters": [
        {
          "$ref": "#/components/parameters/profileId"
        }
      ],
      "post": {
        "tags": [
          "transactions"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas.json#/components/schemas/BasicTransactionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The transaction ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64",
            "nullable": false
          }
        }
      ],
      "get": {
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas.json#/components/schemas/TransactionDetails"
                }
              }
            }
          },
          "404": {
            "description": "If transaction does not belong to profile"
          }
        }
      },
      "put": {
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": false
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas.json/#/components/schemas/TransactionDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction updated successfully. Any removed images are also deleted if they do not belong to any other items for the profile"
          }
        }
      },
      "delete": {
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction and Items deleted successfully. Any linked images are also deleted if they do not belong to any other items for the profile*"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/profileId"
          }
        ],
        "tags": [
          "categories"
        ],
        "responses": {
          "200": {
            "description": "",
