<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://www.jooq.org/xsd/jooq-codegen-3.19.8.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.19.8.xsd">
    <logging>DEBUG</logging>
    <jdbc>
        <driver>com.mysql.jdbc.Driver</driver>
        <url>jdbc:mysql://172.26.48.26:3306/expense_tracker_database_dev</url>
    </jdbc>
    <generator>
        <name>org.jooq.codegen.KotlinGenerator</name>
        <database>
            <name>org.jooq.meta.mysql.MySQLDatabase</name>
            <inputSchema>expense_tracker_database_dev</inputSchema>
            <outputSchemaToDefault>true</outputSchemaToDefault>
            <forcedTypes>
                <forcedType>
                    <userType>com.davidgrath.expensetrackerbackend.entities.TransactionMode</userType>
                    <converter>com.davidgrath.expensetrackerbackend.entities.TransactionModeConverter</converter>
<!--                    <enumConverter>true</enumConverter>-->
                    <includeExpression>.*transaction\.mode.*</includeExpression>
                </forcedType>
            </forcedTypes>
        </database>
        <strategy>
            <matchers>
                <tables>
                    <table>
                        <pojoClass>
                            <transform>PASCAL</transform>
                            <expression>$0_Pojo</expression>
                        </pojoClass>
                    </table>
                </tables>
            </matchers>
        </strategy>
        <target>
            <packageName>com.davidgrath.expensetrackerbackend.generated.jooq</packageName>
            <directory>../../app/build/generated/jooq/main</directory>
        </target>
        <generate>
             <pojos>true</pojos>
            <immutablePojos>true</immutablePojos>
            <pojosAsKotlinDataClasses>true</pojosAsKotlinDataClasses>
        </generate>
    </generator>
</configuration>