[Unit]
Description=Expense Tracker Backend

[Service]
WorkingDirectory=/opt/expense_tracker

Environment=PYROSCOPE_APPLICATION_NAME=expense_tracker_backend
Environment=OTEL_SERVICE_NAME=expense_tracker_backend

Environment=PYROSCOPE_SERVER_ADDRESS={{pyroscope_address}}
Environment=PYROSCOPE_LABELS=deployment_environment_name={{deployment_environment}},deployment_environment={{deployment_environment}}
Environment=OTEL_SDK_DISABLED=false
Environment=OTEL_JAVA_AGENT_LOCATION=/opt/opentelemetry
Environment=OTEL_JAVAAGENT_EXTENSIONS=./pyroscope-otel.jar
ExecStart=/bin/bash /opt/expense_tracker/startup.sh

[Install]
WantedBy=multi-user.target